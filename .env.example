# -----------------------------------------------------------------------------
# LeadMap — environment variables
#
# Copy this file to `.env.local` and fill in real values. Validated at boot by
# config/env.ts (architecture.md §13.4) — the app will refuse to start if a
# required variable is missing or malformed.
#
# These are application secrets only. Business Discovery needs no API key at
# all (OpenStreetMap-backed — Overpass API, Nominatim). An AI provider key is
# optional, bring-your-own-key, entered in Settings, and stored encrypted in
# the database — never an environment variable (architecture.md §7.2, §11.1).
# -----------------------------------------------------------------------------

# Postgres connection string (Neon or Supabase free tier), pointed at the
# connection pooler, not the direct connection (architecture.md §15).
# Example: postgres://user:password@host-pooler.region.aws.neon.tech/leadmap?sslmode=require
DATABASE_URL=

# Auth.js session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers (optional — omit to leave that provider disabled).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AES-256-GCM master key used to encrypt user-provided AI API keys at rest
# (architecture.md §13.4). Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Sentry error monitoring DSN (optional in development). Both point at the
# same Sentry project — SENTRY_DSN is read server/edge-side
# (instrumentation.ts), NEXT_PUBLIC_SENTRY_DSN client-side
# (instrumentation-client.ts), since only NEXT_PUBLIC_* vars are inlined
# into the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Sentry release tooling (optional — only needed to upload source maps on
# build; omit to build without source-map upload). See
# https://docs.sentry.io/platforms/javascript/guides/nextjs/manual-setup/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Public base URL of the deployment, used for auth callback URLs, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000
